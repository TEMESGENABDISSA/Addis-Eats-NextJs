@host = http://localhost:3001/api/v1

### Restaurants - List all (Page<T>)
GET {{host}}/restaurants

### Restaurants - Filter by area
GET {{host}}/restaurants?area=Bole

### Restaurants - Filter by isOpen
GET {{host}}/restaurants?isOpen=true

### Restaurants - Limit and offset
GET {{host}}/restaurants?limit=2&offset=0

### Restaurants - Sort by name (ascending)
GET {{host}}/restaurants?sort=name

### Restaurants - Sort by name (descending)
GET {{host}}/restaurants?sort=-name

### Restaurants - Get one
GET {{host}}/restaurants/1

### Restaurants - Get non-existent (404)
GET {{host}}/restaurants/99

### Restaurants - Create valid (201 with Location)
POST {{host}}/restaurants
Content-Type: application/json

{
  "name": "Sishu",
  "area": "Kazanchis"
}

### Restaurants - Create with invalid area (400)
POST {{host}}/restaurants
Content-Type: application/json

{
  "name": "Test",
  "area": "Adama"
}

### Restaurants - Create with unknown field (stripped)
POST {{host}}/restaurants
Content-Type: application/json

{
  "name": "Test",
  "area": "Bole",
  "hacked": true
}

### Restaurants - Get dishes for restaurant
GET {{host}}/restaurants/1/dishes

### Restaurants - Get dishes for non-existent restaurant (404)
GET {{host}}/restaurants/99/dishes

### Restaurants - Get orders for restaurant
GET {{host}}/restaurants/1/orders

### Restaurants - Get orders for non-existent restaurant (404)
GET {{host}}/restaurants/99/orders

### Dishes - List all (Page<T>)
GET {{host}}/dishes

### Dishes - Filter by restaurant
GET {{host}}/dishes?restaurantId=1

### Dishes - Get one
GET {{host}}/dishes/1

### Dishes - Get non-existent (404)
GET {{host}}/dishes/99

### Dishes - Create valid (201 with Location)
POST {{host}}/dishes
Content-Type: application/json

{
  "name": "Tibs",
  "priceSantim": 29000,
  "restaurantId": 1
}

### Dishes - Create with missing restaurant (404)
POST {{host}}/dishes
Content-Type: application/json

{
  "name": "Test",
  "priceSantim": 10000,
  "restaurantId": 99
}

### Orders - List all (Page<T>)
GET {{host}}/orders

### Orders - Filter by status
GET {{host}}/orders?status=PENDING

### Orders - Filter by area
GET {{host}}/orders?area=Bole

### Orders - Limit and offset
GET {{host}}/orders?limit=5&offset=0

### Orders - Sort by customerName (descending)
GET {{host}}/orders?sort=-customerName

### Orders - Get one
GET {{host}}/orders/1

### Orders - Get non-existent (404)
GET {{host}}/orders/99

### Orders - Update status
PATCH {{host}}/orders/1/status
Content-Type: application/json

{
  "status": "PREPARING"
}

### Orders - Delete (204)
DELETE {{host}}/orders/5

### Orders - Delete again (204 - idempotent)
DELETE {{host}}/orders/5

### Orders - Delete non-existent (404)
DELETE {{host}}/orders/99

### Orders - Create valid (201 with Location)
POST {{host}}/orders
Content-Type: application/json

{
  "customerName": "Test Customer",
  "area": "Bole",
  "restaurantId": 1,
  "totalSantim": 32000,
  "dishes": [
    {
      "name": "Doro Wat",
      "priceSantim": 32000
    }
  ]
}

### Unversioned path should return 404
GET http://localhost:3001/api/restaurants
